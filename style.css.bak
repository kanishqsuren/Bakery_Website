/* ==========================================================================
   SweetCrumbs Bakery - warm cream & chocolate theme
   Plain CSS only: no frameworks, no external fonts or libraries.
   ========================================================================== */

/* --- Design tokens ------------------------------------------------------- */
:root {
  /* Warm cream / beige surfaces */
  --cream:        #fdf7ec;
  --cream-deep:   #f8efdf;
  --beige:        #f1e3cc;
  --beige-dark:   #e6d3b6;
  --card:         #fffdf8;

  /* Dark chocolate ink */
  --choco:        #3a2316;
  --choco-soft:   #5a3b27;
  --choco-muted:  #7a5a42;

  /* Accent */
  --caramel:      #b5783c;

  /* Lines & shadows */
  --line:         rgba(58, 35, 22, 0.14);
  --shadow-sm:    0 1px 2px rgba(58, 35, 22, 0.06),
                  0 4px 14px rgba(58, 35, 22, 0.06);
  --shadow-md:    0 10px 30px rgba(58, 35, 22, 0.10);
  --shadow-btn:   0 8px 18px rgba(58, 35, 22, 0.22);

  /* Type */
  --serif:  Georgia, "Times New Roman", "Iowan Old Style", serif;
  --sans:   "Segoe UI", Avenir, "Helvetica Neue", Arial, sans-serif;

  /* Layout */
  --measure: 1120px;
  --gutter:  24px;
  --header-h: 76px;
}

/* --- Base ---------------------------------------------------------------- */
*,
*::before,
*::after { box-sizing: border-box; }

html {
  scroll-behavior: smooth;           /* makes the existing Explore scroll glide */
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--cream);
  /* Soft warm light in the upper corners, gentle beige wash at the bottom */
  background-image:
    radial-gradient(900px 480px at 12% -8%,  rgba(241, 227, 204, 0.85), transparent 70%),
    radial-gradient(760px 420px at 92% 2%,   rgba(230, 211, 182, 0.55), transparent 70%),
    linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 100%);
  background-repeat: no-repeat;
  background-attachment: fixed;
  color: var(--choco-soft);
  font-family: var(--sans);
  font-size: 17px;
  line-height: 1.7;
  letter-spacing: 0.01em;
}

/* Headings in dark chocolate */
h1, h2, h3 {
  margin: 0;
  color: var(--choco);
  font-family: var(--serif);
  font-weight: 700;
  letter-spacing: -0.015em;
  line-height: 1.15;
}

p { margin: 0 0 1.1rem; }
p:last-child { margin-bottom: 0; }

::selection {
  background: var(--beige-dark);
  color: var(--choco);
}

/* Shared width wrapper */
.container {
  width: 100%;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* Anchor targets clear the sticky header */
section { scroll-margin-top: calc(var(--header-h) + 16px); }

/* --- Header -------------------------------------------------------------- */
header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(253, 247, 236, 0.88);
  -webkit-backdrop-filter: saturate(140%) blur(10px);
  backdrop-filter: saturate(140%) blur(10px);
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
}

.header-inner {
  min-height: var(--header-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

/* Bakery name, left */
header h1 {
  font-size: 1.5rem;
  letter-spacing: 0.005em;
  white-space: nowrap;
}

/* Small caramel dot after the name, purely decorative */
header h1::after {
  content: "";
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-left: 7px;
  border-radius: 50%;
  background: var(--caramel);
  vertical-align: 0.18em;
}

/* Navigation, right */
nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px 6px;
}

nav a {
  position: relative;
  padding: 9px 14px;
  border-radius: 8px;
  color: var(--choco);
  font-family: var(--sans);
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  text-decoration: none;
  transition: color 0.22s ease, background-color 0.22s ease;
}

/* Animated underline on hover */
nav a::after {
  content: "";
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 4px;
  height: 2px;
  border-radius: 2px;
  background: var(--caramel);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.26s ease;
}

nav a:hover,
nav a:focus-visible {
  color: var(--caramel);
  background-color: rgba(241, 227, 204, 0.75);
}

nav a:hover::after,
nav a:focus-visible::after { transform: scaleX(1); }

/* --- Hero (#home) -------------------------------------------------------- */
#home {
  position: relative;
  overflow: hidden;
  margin: 0;
  padding: clamp(72px, 11vw, 136px) var(--gutter) clamp(80px, 12vw, 148px);
  text-align: center;
  background-image:
    radial-gradient(620px 340px at 50% 12%, rgba(255, 253, 248, 0.95), transparent 72%),
    radial-gradient(520px 300px at 8% 92%,  rgba(230, 211, 182, 0.50), transparent 70%),
    radial-gradient(520px 300px at 94% 86%, rgba(230, 211, 182, 0.42), transparent 70%);
  border-bottom: 1px solid var(--line);
}

.hero-content {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
}

/* Large, bold hero heading */
#home h2 {
  font-size: clamp(2.6rem, 7.4vw, 4.75rem);
  line-height: 1.04;
  letter-spacing: -0.03em;
  text-wrap: balance;
  margin-bottom: 26px;
  text-shadow: 0 1px 0 rgba(255, 253, 248, 0.6);
}

/* Short caramel rule beneath the heading */
#home h2::after {
  content: "";
  display: block;
  width: 86px;
  height: 3px;
  margin: 28px auto 0;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--caramel), var(--beige-dark));
}

#home p {
  max-width: 620px;
  margin: 0 auto 38px;
  font-size: clamp(1.02rem, 1.6vw, 1.16rem);
  color: var(--choco-muted);
  text-wrap: pretty;
}

/* --- Button -------------------------------------------------------------- */
button {
  display: inline-block;
  padding: 16px 38px;
  border: 0;
  border-radius: 999px;
  background-color: var(--choco);
  color: #fffdf8;
  font-family: var(--sans);
  font-size: 0.86rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  cursor: pointer;
  box-shadow: var(--shadow-btn);
  transition: background-color 0.24s ease,
              transform 0.18s ease,
              box-shadow 0.24s ease;
}

button:hover {
  background-color: var(--caramel);
  transform: translateY(-3px);
  box-shadow: 0 14px 26px rgba(58, 35, 22, 0.28);
}

button:active {
  transform: translateY(-1px);
  box-shadow: 0 6px 14px rgba(58, 35, 22, 0.24);
}

button:focus-visible {
  outline: 3px solid var(--caramel);
  outline-offset: 3px;
}

/* --- About --------------------------------------------------------------- */
main { display: block; }

#about {
  margin: 0 auto;
  padding: clamp(64px, 9vw, 104px) 0;
}

.about-card {
  display: grid;
  grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.5fr);
  gap: clamp(28px, 5vw, 64px);
  align-items: start;
  padding: clamp(32px, 5vw, 60px);
  background-color: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow-md);
}

#about h2 {
  font-size: clamp(1.9rem, 3.4vw, 2.6rem);
  letter-spacing: -0.02em;
}

#about h2::after {
  content: "";
  display: block;
  width: 56px;
  height: 3px;
  margin-top: 18px;
  border-radius: 3px;
  background: var(--beige-dark);
}

#about p {
  max-width: 62ch;
  font-size: 1.04rem;
  color: var(--choco-muted);
  /* Hairline rule on the left to tie the two columns together */
  padding-left: clamp(0px, 2vw, 28px);
  border-left: 1px solid var(--line);
}

/* --- Footer -------------------------------------------------------------- */
footer {
  margin-top: 0;
  padding: 34px 0;
  background-color: var(--beige);
  border-top: 1px solid var(--line);
  text-align: center;
}

footer p {
  margin: 0;
  color: var(--choco-muted);
  font-size: 0.86rem;
  letter-spacing: 0.04em;
}

/* --- Responsive ---------------------------------------------------------- */
@media (max-width: 860px) {
  .about-card { grid-template-columns: 1fr; }

  #about p {
    padding-left: 0;
    border-left: 0;
  }
}

@media (max-width: 680px) {
  :root {
    --gutter: 18px;
    --header-h: auto;
  }

  body { font-size: 16px; }

  .header-inner {
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    padding-bottom: 14px;
    text-align: center;
  }

  header h1 { font-size: 1.35rem; }

  nav { justify-content: center; }

  nav a {
    padding: 8px 10px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  section { scroll-margin-top: 130px; }

  #home { padding-top: 56px; padding-bottom: 64px; }

  #home h2 { font-size: clamp(2.1rem, 9.5vw, 3rem); }

  button {
    width: 100%;
    max-width: 320px;
    padding: 15px 24px;
  }

  .about-card { border-radius: 16px; }
}

/* Respect users who prefer less motion */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }

  button:hover { transform: none; }
}
