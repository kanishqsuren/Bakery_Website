<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SweetCrumbs Bakery</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <div class="container header-inner">
      <h1>SweetCrumbs Bakery</h1>
      <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#menu">Menu</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="home">
      <div class="hero-content">
        <h2>Freshly Baked, Made with Love</h2>
        <p>
          At SweetCrumbs Bakery, we bake small batches of bread, cakes, and pastries
          every morning using simple ingredients and a lot of care.
        </p>
        <button id="exploreBtn">Explore Our Bakery</button>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <div class="about-card">
          <h2>About Us</h2>
          <p>
            SweetCrumbs Bakery is a small neighbourhood bakery run by a family of bakers.
            We started with one oven and one recipe, and we still believe the best baking
            is slow, honest, and shared with friends.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>SweetCrumbs Bakery &copy; 2026. All rights reserved.</p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
