{
  "name": "sweetcrumbs-bakery",
  "version": "1.0.0",
  "private": true,
  "description": "SweetCrumbs Bakery website with an Express + SQLite backend and admin CMS",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "seed": "node server/seed.js",
    "reset-db": "node server/seed.js --force"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.5.0",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-session": "1.19.0"
  }
}
